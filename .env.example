# Copy to .env and replace both secrets. .env is never committed.
POSTGRES_PASSWORD=change-me-database-password
# At least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# true only when the site is served over https
COOKIE_SECURE=false
WEB_PORT=8080
# Phones that become admins when they sign up or sign in, e.g. +77001234567
ADMIN_PHONES=
# Packages a new student gets until a manager sets them: basic, or basic,extra
DEFAULT_PACKAGES=basic
